# Copy this file to .env and fill it in. Never commit .env.

# The address you use for Canvas, e.g. https://myschool.instructure.com
CANVAS_URL=
# Canvas > Account > Settings > Approved Integrations > + New Access Token
CANVAS_TOKEN=

# Your time zone, e.g. America/Los_Angeles. Needed when running in the cloud.
STUDENT_TIMEZONE=

# When study sessions can start each day (24-hour time). Default 16:00.
STUDY_START=16:00
# Google sign-in files (see README). Both stay out of git.
GOOGLE_CREDENTIALS=credentials.json
GOOGLE_TOKEN=token.json
